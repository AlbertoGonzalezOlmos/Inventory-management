# Opticon barcode scanners — device-node permissions (all personalities).
#
# Install once (needs sudo; the rules survive reboots and usbipd re-attaches):
#   sudo cp scripts/udev/99-opticon-scanner.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   then re-plug / re-attach the device (usbipd detach + attach on WSL2).
#
# GROUP=plugdev matches stock Ubuntu/Debian WSL images (the default user is
# already a member; verify with `id`). On other distros use GROUP="dialout"
# or GROUP="users" as appropriate.
#
# Covers:
#  * tty subsystem    — /dev/ttyUSB* for the OPN-2001 (opticon usb-serial
#                       driver) and /dev/ttyACM* for CDC-ACM scanners
#  * hidraw subsystem — /dev/hidraw* for HID-keyboard-mode scanners
#                       (scripts/scanner_hid.py)
#  * usb subsystem    — /dev/bus/usb/... nodes so the raw-libusb backend
#                       (scripts/opn2001.py --backend usb, pyusb) can claim
#                       the device without root

SUBSYSTEM=="tty",    ATTRS{idVendor}=="065a", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="065a", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb",    ATTRS{idVendor}=="065a", MODE="0664", GROUP="plugdev"
