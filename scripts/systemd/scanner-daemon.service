# HCRM scanner grab daemon — systemd system unit (round 4, T3).
#
# MANUAL INSTALL (deliberately not done by any script — the round-4 hardware
# checklist, docs/plans/r4-checklist.md, is the live gate):
#   sudo cp scripts/systemd/scanner-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scanner-daemon
#   journalctl -u scanner-daemon -f      # watch the grab/re-discovery log
#
# Why these settings:
#   * Restart=always + RestartSec=2 — the daemon's exit releases the grab
#     (kernel: grab lifetime == fd lifetime), and during any gap the scanner
#     reverts to keyboard-wedge into whatever window has focus; a crashed
#     daemon must come back within seconds, not at the next boot.
#   * SupplementaryGroups=input — /dev/input/eventN is root:input 0660
#     (measured, r4rev M4). With the udev rule installed
#     (scripts/udev/99-opticon-scanner.rules, GROUP=plugdev) the group is
#     redundant but harmless; keep whichever exists on this distro.
#   * After=systemd-udevd.service — the device node only exists once udev
#     has processed the plug event; the daemon tolerates its absence
#     (re-discovery loop), but this ordering removes the first-boot race.
#
# NOTE: the ExecStart below is the REAL T5 entrypoint. One-time setup,
# in order:
#   1. install the udev rule (see above) and re-plug the scanner;
#   2. register the terminal once — it writes the single-use pairing
#      offer file (0600) the server's one-click endpoint reads:
#        uv run python scripts/scanner_daemon.py \
#             --config /etc/hcrm/scanner.json --register
#      (that run also starts forwarding; Ctrl-C once it has registered —
#      SIGTERM/SIGINT are clean exits and the config is already saved);
#   3. in the kiosk browser, click the "no scanner" pill in the header
#      once — the server reads the offer file, pairs the browser and
#      consumes the file. No code is typed, and none is printed (the
#      pairing code must never touch a journal; --print-code opts in for
#      the manual POST /api/scanner/pair fallback);
#   4. systemctl start scanner-daemon — from here it forwards forever.
# The unit itself never passes --register, but note the daemon's contract:
# it registers itself whenever the config is ABSENT (spec: "no config →
# register") — so a first `systemctl start` without step 2 still works.
# Once the config exists, restarts never register again. Step 2 remains
# the recommended flow.
#
# ONE-CLICK PAIRING CAVEAT: the offer file's default location is
# <WorkingDirectory>/data/scanner-pairing.json, and the SERVER must be
# able to READ it. This unit runs as root (no User=), so a root-written
# 0600 offer file is unreadable by a non-root server — /pair/auto would
# answer 500 naming the fix. Either run the daemon as the app user
# (User=hcrm + the SupplementaryGroups below is sufficient for EVIOCGRAB
# on the root:input 0660 node), or set the same
# HCRM_SCANNER_PAIRING_FILE on both the daemon and the server to a path
# both can reach. Adjust WorkingDirectory to the checkout/deployment
# being run.

[Unit]
Description=HCRM scanner grab daemon (Opticon M-10, USB-HID keyboard mode 065a:a001)
Documentation=file:/opt/hcrm/docs/opticon-hardware.md
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=simple
WorkingDirectory=/opt/hcrm
ExecStart=/usr/bin/env uv run python scripts/scanner_daemon.py --config /etc/hcrm/scanner.json --forward http://127.0.0.1:8000
Restart=always
RestartSec=2
SupplementaryGroups=input plugdev
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
